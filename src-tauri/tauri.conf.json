{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiVision",
  "version": "0.1.0",
  "identifier": "com.digivision.demo",
  "build": {
    "beforeDevCommand": "npm run app:backend && npm run build",
    "beforeBuildCommand": "npm run app:backend && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Digi Vision",
        "width": 1440,
        "height": 810,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "backgroundColor": "#31313b"
      },
      {
        "label": "splashscreen",
        "title": "DigiVision",
        "url": "splash.html",
        "width": 1200,
        "height": 820,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "backgroundColor": "#18191C"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/digivision-backend/": "backend/",
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    }
  }
}
